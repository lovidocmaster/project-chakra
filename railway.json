{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install flask flask-cors gunicorn python-dotenv requests"
  },
  "deploy": {
    "startCommand": "gunicorn chakra.app:app --bind 0.0.0.0:$PORT --workers 1 --timeout 120",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}